{
  "manifest_version": 2,
  "name": "Cue In-App Web Console",
  "version": "1.0",
  "description": "Opt-in top-frame console relay for the in-app developer panel.",
  "browser_specific_settings": {
    "gecko": {
      "id": "cue-web-console@cue.im"
    }
  },
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons",
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["main-world.js"],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["relay.js"],
      "run_at": "document_start",
      "all_frames": false,
      "world": "ISOLATED"
    }
  ]
}
